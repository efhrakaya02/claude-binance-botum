# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# .env dosyası ASLA git'e eklenmemeli (bkz. .gitignore).

BINANCE_API_KEY=buraya_api_key_yaz
BINANCE_API_SECRET=buraya_api_secret_yaz

# true = testnet.binancefuture.com üzerinde çalışır (gerçek para riski yok)
# false = gerçek Binance Futures hesabında çalışır
BINANCE_TESTNET=true

# true = HİÇBİR gerçek emir göndermez, sadece "şunu açardım/kapatırdım" diye
# loglar (piyasa verisi gerçek/canlı olur, sadece emir gönderimi simüle edilir).
# Bu moddayken BINANCE_API_KEY/SECRET bile gerekmez.
DRY_RUN=true
